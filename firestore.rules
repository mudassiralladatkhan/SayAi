rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Documents ────────────────────────────────────────────────────────
    // A user can ONLY read and write their OWN document.
    // No other authenticated user can access it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Tasks Sub-collection ───────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Diary Sub-collection ───────────────────────────────────────────────
      match /diary/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Conversations Sub-collection ───────────────────────────────────────
      match /conversations/{convId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Mood Log Sub-collection ────────────────────────────────────────────
      match /mood_log/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Usage Sub-collection ───────────────────────────────────────────────
      match /usage/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    // Any collection or document not listed above is DENIED by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
